{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run tokens:build)",
      "Bash(npm run dc:generate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*serviceAccount*.json)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*-key.json)",
      "Read(./**/*.pem)",
      "Bash(firebase deploy:*)",
      "Bash(npm run dc:migrate:*)"
    ]
  }
}
