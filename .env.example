# Copy to .env.local for local development. NEVER commit .env.local.
# Production secrets live in Google Secret Manager — see docs/02-architecture.md §10.

# Public site origin, used for canonical URLs, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# MOCK AUTHENTICATION — DEVELOPMENT ONLY
#
# Setting this to "true" enables /api/auth/mock-login, which issues a session
# for ANY role on request. It is how the role switcher and the admin screens
# are exercised before Firebase Auth is wired up.
#
# It is impossible to enable in a production build: isMockAuthEnabled() also
# requires NODE_ENV !== 'production', so this variable alone cannot unlock it.
# See src/lib/auth/mock.ts.
#
# Leave unset to develop against the real (locked-down) behaviour.
# ─────────────────────────────────────────────────────────────────────────────
ASOO_ENABLE_MOCK_AUTH=true

# Firebase — Phase 2. Client config is public by design; the Admin SDK
# service account is NOT and must come from Secret Manager at runtime.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Payments — Phase 5. See docs/07-payments.md.
# PAYMENT_PROVIDER=mock
