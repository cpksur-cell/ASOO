{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "ASOO Portal design tokens. SINGLE SOURCE OF TRUTH. Generates CSS custom properties (light + dark) via `npm run tokens:build`, which fails the build if any text pairing drops below WCAG AA in EITHER theme. Never write a raw hex or pixel value in a component.",

  "primitive": {
    "$comment": "Raw ramps. Components MUST NOT consume this layer directly — use `semantic`.",

    "color": {
      "primary": {
        "$comment": "Ink navy. The authority tone. Desaturated and cool — a precision instrument, not a generic civic blue. Dark enough at 700 to carry white text at AAA.",
        "50":  "#EEF3F8",
        "100": "#D6E2EE",
        "200": "#AEC5DB",
        "300": "#7CA0BF",
        "400": "#4A78A0",
        "500": "#2A5A82",
        "600": "#1D4668",
        "700": "#143751",
        "800": "#0E2739",
        "900": "#081824",
        "950": "#040E16"
      },
      "accent": {
        "$comment": "Survey orange — the hi-vis of the profession: tripods, benchmark caps, field vests. The system's signature. 400 is the signature tone but is a FILL only (ink text on it, never white — measured 3.18:1). 700 is the text-safe tone on light; 300 on dark.",
        "50":  "#FEF4EC",
        "100": "#FBE2CC",
        "200": "#F6C296",
        "300": "#EE9C58",
        "400": "#E2711D",
        "500": "#C75E12",
        "600": "#A34C0E",
        "700": "#823D0C",
        "800": "#612E0A",
        "900": "#401F07"
      },
      "neutral": {
        "$comment": "Limestone. Amman is built of it — the city is literally white stone. A barely-perceptible warmth in the light end, resolving to a neutral cool at the dark end so it never reads brown. Specific to this place rather than a generic cool grey.",
        "0":   "#FFFFFF",
        "50":  "#FAF9F7",
        "100": "#F1F0EC",
        "200": "#E3E1DB",
        "300": "#C7C4BC",
        "400": "#9B978F",
        "500": "#76736C",
        "600": "#55524D",
        "700": "#3B3936",
        "800": "#252422",
        "900": "#161514",
        "950": "#0C0B0B"
      },
      "green": {
        "50": "#E9F6F0", "100": "#C4E8D8", "300": "#6FD3A5", "500": "#127750", "600": "#0F6845", "700": "#0C5238",
        "dbg": "#0E2A1F", "dborder": "#17422F"
      },
      "amber": {
        "50": "#FEF5E7", "100": "#FBE3BC", "300": "#E8B25A", "500": "#9C6A0B", "600": "#875C09", "700": "#6E4A07",
        "dbg": "#2A1E08", "dborder": "#43310F"
      },
      "red": {
        "50": "#FDECEC", "100": "#F9CFCF", "300": "#F08D8D", "500": "#B01F27", "600": "#951920", "700": "#7A141A",
        "dbg": "#2C1214", "dborder": "#46191D"
      },
      "blue": {
        "50": "#EBF2FA", "100": "#CCDFF2", "300": "#7FB6E8", "500": "#1A5C91", "600": "#154A75", "700": "#12456F",
        "dbg": "#0D2033", "dborder": "#14304C"
      },
      "ink": {
        "$comment": "Dark-theme canvas family. Navy-tinted near-blacks, so dark mode reads as the same brand rather than a generic grey inversion.",
        "canvas":  "#0B1117",
        "surface": "#121A22",
        "raised":  "#18222C",
        "sunken":  "#080D12",
        "line":    "#22303C",
        "lineStrong": "#31424F"
      },
      "plan": {
        "$comment": "The cadastral plan motif — parcel boundaries, corner monuments, bearing ticks. Decorative and deliberately below the 3:1 UI threshold so it recedes behind content.",
        "line": "#D7D4CC",
        "lineStrong": "#BDB9AF",
        "onDark": "#22303C",
        "onDarkStrong": "#31424F"
      }
    },

    "space": {
      "$comment": "4px base.",
      "0": "0", "px": "1px", "0.5": "0.125rem", "1": "0.25rem", "1.5": "0.375rem",
      "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem",
      "8": "2rem", "10": "2.5rem", "12": "3rem", "14": "3.5rem", "16": "4rem",
      "20": "5rem", "24": "6rem", "32": "8rem"
    },

    "radius": {
      "none": "0", "sm": "0.25rem", "md": "0.5rem", "lg": "0.75rem",
      "xl": "1rem", "2xl": "1.5rem", "full": "9999px"
    },

    "fontFamily": {
      "$comment": "Display carries the personality; body is the engineered workhorse. Readex Pro is a true AR+EN variable superfamily with a confident, slightly condensed voice — deliberately not the default technical pairing. IBM Plex Sans Arabic handles long-form and UI because it stays legible at small sizes. Plex Mono carries coordinates, licence numbers, and money.",
      "display": "'Readex Pro', 'IBM Plex Sans Arabic', system-ui, sans-serif",
      "arabic": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', system-ui, sans-serif",
      "latin": "'IBM Plex Sans', system-ui, -apple-system, sans-serif",
      "mono": "'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace"
    },

    "fontWeight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },

    "fontSize": {
      "$comment": "Latin scale. Arabic uses `fontSizeArabic` — see docs/05-design-system.md §3.",
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
      "xl": "1.25rem", "2xl": "1.5rem", "3xl": "1.875rem", "4xl": "2.25rem",
      "5xl": "3rem", "6xl": "3.75rem"
    },

    "fontSizeArabic": {
      "$comment": "Arabic runs ~8-12% larger at the same nominal step. Arabic letterforms carry more detail in connecting strokes and below the baseline; matching Latin pixel sizes makes Arabic read smaller and thinner than it is.",
      "xs": "0.8125rem", "sm": "0.9375rem", "base": "1.0625rem", "lg": "1.1875rem",
      "xl": "1.375rem", "2xl": "1.625rem", "3xl": "2rem", "4xl": "2.375rem",
      "5xl": "3.125rem", "6xl": "3.875rem"
    },

    "lineHeight": {
      "$comment": "Arabic needs more leading than Latin — diacritics and descenders collide at Latin-typical values.",
      "tight": "1.15", "snug": "1.3", "normal": "1.5", "relaxed": "1.65",
      "arabicTight": "1.3", "arabicNormal": "1.75", "arabicRelaxed": "1.9"
    },

    "tracking": {
      "$comment": "Latin display only. Arabic is NEVER letter-spaced — it breaks the connecting strokes and renders the word illegible.",
      "tight": "-0.02em", "normal": "0", "wide": "0.04em", "wider": "0.09em"
    },

    "shadow": {
      "$comment": "Restrained. Shadows communicate elevation, not decoration. Navy-tinted rather than neutral black so they sit in the palette.",
      "none": "none",
      "sm": "0 1px 2px 0 rgb(8 24 36 / 0.06)",
      "md": "0 2px 8px -2px rgb(8 24 36 / 0.10), 0 1px 3px -1px rgb(8 24 36 / 0.06)",
      "lg": "0 12px 28px -8px rgb(8 24 36 / 0.16), 0 4px 10px -4px rgb(8 24 36 / 0.08)",
      "xl": "0 24px 56px -16px rgb(8 24 36 / 0.22), 0 8px 20px -8px rgb(8 24 36 / 0.10)"
    },

    "duration": { "instant": "0ms", "fast": "120ms", "normal": "200ms", "slow": "320ms", "plan": "1400ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },

    "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px" },
    "container": { "max": "1280px", "prose": "68ch", "form": "40rem" },
    "zIndex": {
      "base": "0", "dropdown": "1000", "sticky": "1100", "bottomnav": "1150",
      "overlay": "1200", "modal": "1300", "popover": "1400", "toast": "1500"
    }
  },

  "semantic": {
    "$comment": "What components consume. Both themes are authored together so brand, contrast, and style stay consistent — dark is not an inversion.",

    "light": {
      "surface": {
        "canvas":      { "value": "{primitive.color.neutral.50}",  "use": "page background" },
        "default":     { "value": "{primitive.color.neutral.0}",   "use": "cards, panels" },
        "raised":      { "value": "{primitive.color.neutral.0}",   "use": "elevated cards" },
        "sunken":      { "value": "{primitive.color.neutral.100}", "use": "wells, table headers" },
        "inverse":     { "value": "{primitive.color.primary.800}", "use": "footer, dark bands" },
        "brand":       { "value": "{primitive.color.primary.700}", "use": "primary buttons, header" },
        "brandSubtle": { "value": "{primitive.color.primary.50}",  "use": "brand-tinted backgrounds" },
        "accent":      { "value": "{primitive.color.accent.400}",  "use": "signature fill — INK text only" },
        "accentSubtle":{ "value": "{primitive.color.accent.50}",   "use": "official-artefact backgrounds" },
        "rule":        { "value": "{primitive.color.accent.400}",  "use": "the 3px station rule. Decorative only." },
        "plan":        { "value": "{primitive.color.plan.line}",   "use": "cadastral parcel boundaries" },
        "planStrong":  { "value": "{primitive.color.plan.lineStrong}", "use": "cadastral corner monuments" }
      },
      "text": {
        "primary":   { "value": "{primitive.color.neutral.900}", "on": "surface.default" },
        "secondary": { "value": "{primitive.color.neutral.700}", "on": "surface.default" },
        "muted":     { "value": "{primitive.color.neutral.600}", "on": "surface.default" },
        "disabled":  { "value": "{primitive.color.neutral.400}", "on": "surface.default", "exempt": true, "note": "BELOW AA by design — disabled state only, never readable content." },
        "onBrand":   { "value": "{primitive.color.neutral.0}",   "on": "surface.brand" },
        "onInverse": { "value": "{primitive.color.neutral.0}",   "on": "surface.inverse" },
        "onAccent":  { "value": "{primitive.color.primary.900}", "on": "surface.accent", "note": "MEASURED: white on accent-400 is 3.18:1 and FAILS AA. Ink is the only permissible foreground." },
        "brand":     { "value": "{primitive.color.primary.700}", "on": "surface.default" },
        "accent":    { "value": "{primitive.color.accent.700}",  "on": "surface.default" },
        "link":      { "value": "{primitive.color.primary.700}", "on": "surface.default" }
      },
      "border": {
        "subtle":  "{primitive.color.neutral.200}",
        "default": "{primitive.color.neutral.300}",
        "strong":  "{primitive.color.neutral.400}",
        "brand":   "{primitive.color.primary.600}",
        "focus":   "{primitive.color.accent.500}"
      },
      "status": {
        "$comment": "fg / bg / border triplets. Status is NEVER signalled by colour alone — every badge carries an icon and a text label.",
        "active":  { "fg": "{primitive.color.green.700}",  "bg": "{primitive.color.green.50}",  "border": "{primitive.color.green.100}",  "means": "member active · invoice paid" },
        "pending": { "fg": "{primitive.color.blue.700}",   "bg": "{primitive.color.blue.50}",   "border": "{primitive.color.blue.100}",   "means": "under review · processing" },
        "warning": { "fg": "{primitive.color.amber.700}",  "bg": "{primitive.color.amber.50}",  "border": "{primitive.color.amber.100}",  "means": "due soon · expiring" },
        "overdue": { "fg": "{primitive.color.red.700}",    "bg": "{primitive.color.red.50}",    "border": "{primitive.color.red.100}",    "means": "overdue · suspended · revoked" },
        "neutral": { "fg": "{primitive.color.neutral.700}","bg": "{primitive.color.neutral.100}","border": "{primitive.color.neutral.200}","means": "draft · archived · withdrawn" }
      }
    },

    "dark": {
      "surface": {
        "canvas":      { "value": "{primitive.color.ink.canvas}",  "use": "page background" },
        "default":     { "value": "{primitive.color.ink.surface}", "use": "cards, panels" },
        "raised":      { "value": "{primitive.color.ink.raised}",  "use": "elevated cards" },
        "sunken":      { "value": "{primitive.color.ink.sunken}",  "use": "wells, table headers" },
        "inverse":     { "value": "{primitive.color.ink.sunken}",  "use": "footer — deeper, not lighter, in dark" },
        "brand":       { "value": "{primitive.color.primary.500}", "use": "primary buttons, header" },
        "brandSubtle": { "value": "{primitive.color.primary.900}", "use": "brand-tinted backgrounds" },
        "accent":      { "value": "{primitive.color.accent.400}",  "use": "signature fill — INK text only" },
        "accentSubtle":{ "value": "{primitive.color.accent.900}",  "use": "official-artefact backgrounds" },
        "rule":        { "value": "{primitive.color.accent.400}",  "use": "the 3px station rule" },
        "plan":        { "value": "{primitive.color.plan.onDark}", "use": "cadastral parcel boundaries" },
        "planStrong":  { "value": "{primitive.color.plan.onDarkStrong}", "use": "cadastral corner monuments" }
      },
      "text": {
        "primary":   { "value": "{primitive.color.neutral.100}", "on": "surface.default" },
        "secondary": { "value": "{primitive.color.neutral.300}", "on": "surface.default" },
        "muted":     { "value": "{primitive.color.neutral.400}", "on": "surface.default" },
        "disabled":  { "value": "{primitive.color.neutral.600}", "on": "surface.default", "exempt": true, "note": "BELOW AA by design — disabled state only." },
        "onBrand":   { "value": "{primitive.color.neutral.0}",   "on": "surface.brand" },
        "onInverse": { "value": "{primitive.color.neutral.100}", "on": "surface.inverse" },
        "onAccent":  { "value": "{primitive.color.primary.950}", "on": "surface.accent" },
        "brand":     { "value": "{primitive.color.primary.200}", "on": "surface.default" },
        "accent":    { "value": "{primitive.color.accent.300}",  "on": "surface.default" },
        "link":      { "value": "{primitive.color.primary.200}", "on": "surface.default" }
      },
      "border": {
        "subtle":  "{primitive.color.ink.line}",
        "default": "{primitive.color.ink.lineStrong}",
        "strong":  "{primitive.color.primary.400}",
        "brand":   "{primitive.color.primary.400}",
        "focus":   "{primitive.color.accent.300}"
      },
      "status": {
        "active":  { "fg": "{primitive.color.green.300}",  "bg": "{primitive.color.green.dbg}",  "border": "{primitive.color.green.dborder}",  "means": "member active · invoice paid" },
        "pending": { "fg": "{primitive.color.blue.300}",   "bg": "{primitive.color.blue.dbg}",   "border": "{primitive.color.blue.dborder}",   "means": "under review · processing" },
        "warning": { "fg": "{primitive.color.amber.300}",  "bg": "{primitive.color.amber.dbg}",  "border": "{primitive.color.amber.dborder}",  "means": "due soon · expiring" },
        "overdue": { "fg": "{primitive.color.red.300}",    "bg": "{primitive.color.red.dbg}",    "border": "{primitive.color.red.dborder}",    "means": "overdue · suspended · revoked" },
        "neutral": { "fg": "{primitive.color.neutral.300}","bg": "{primitive.color.ink.raised}", "border": "{primitive.color.ink.line}",       "means": "draft · archived · withdrawn" }
      }
    }
  },

  "component": {
    "header":    { "height": "{primitive.space.16}", "heightMobile": "{primitive.space.14}" },
    "bottomNav": { "height": "{primitive.space.16}" },
    "sidebar":   { "width": "17rem", "widthCollapsed": "{primitive.space.16}" },
    "focusRing": { "width": "3px", "offset": "2px" },
    "touchTarget": { "min": "44px", "$comment": "WCAG 2.1 AA. Field surveyors use this outdoors, sometimes with gloves." }
  }
}
